      "校园网",
      "统一身份认证",
      "请先登录",
      "登录超时",
      "无权限访问"
    ],
    "weakReminderKeys": [
      "登录",
      "认证",
      "VPN"
    ]
  },
  "upstreamTimeoutMs": 600000
}
