{
  "schemaVersion": 1,
  "id": "local.zhixiaohang-guard",
  "name": "南航智小航守护网关",
  "version": "1.1.5",
  "description": "南航智小航（https://token.nuaa.edu.cn/v1）专属本地守护网关：彻底无视系统代理（启动即清除 HTTP_PROXY/HTTPS_PROXY/ALL_PROXY 并自建直连 Agent），按需拉起私有 zju-connect EasyConnect 隧道（默认不启动，探测到校外才启动，闲置 20 分钟自动关闭），检测官方 Sangfor 虚拟网卡并用 localAddress 绑定发包，28 RPM 滑动窗口排队限流，校外 HTML/乱码响应拦截净化，429 冷却耐心重试与空流自动重试，同时转发 /v1/chat/completions 与 /v1/responses。",
  "main": "main.js",
  "permissions": [
    "background.service"
  ],
  "net": {
    "domains": [
      "token.nuaa.edu.cn",
      "v.nuaa.edu.cn"
    ]
  },
  "engines": {
    "piDesktop": ">=0.9.0"
  },
  "activationEvents": [
    "onStartup"
  ],
  "contributes": {
    "services": [
      {
        "id": "zhixiaohang-gateway",
        "label": "智小航本地守护网关"
      }
    ],
    "commands": [
      {
        "id": "zhixiaohang.status",
        "title": "智小航: 显示网关状态",
        "category": "AI",
        "keywords": [
          "zhixiaohang",
          "智小航",
          "状态",
          "status",
          "隧道",
          "tunnel"
        ]
      },
      {
        "id": "zhixiaohang.probe",
        "title": "智小航: 网络探测诊断",
        "category": "AI",
        "keywords": [
          "zhixiaohang",
          "智小航",
          "探测",
          "probe",
          "诊断",
          "代理",
          "网络"
        ]
      },
      {
        "id": "zhixiaohang.provider-config",
        "title": "智小航: 显示可编辑兼容服务配置",
        "category": "AI",
        "keywords": [
          "zhixiaohang",
          "智小航",
          "provider",
          "服务",
          "模型",
          "上下文",
          "推理"
        ]
      },
      {
        "id": "zhixiaohang.tunnel-stop",
        "title": "智小航: 立即关闭私有隧道",
        "category": "AI",
        "keywords": [
          "zhixiaohang",
          "智小航",
          "隧道",
          "tunnel",
          "stop"
        ]
      },
      {
        "id": "zhixiaohang.campus-vpn-start",
        "title": "智小航: 启动校内 VPN（浏览客户端）",
        "category": "AI",
        "keywords": [
          "zhixiaohang",
          "智小航",
          "vpn",
          "校内",
          "浏览"
        ]
      },
      {
        "id": "zhixiaohang.campus-vpn-stop",
        "title": "智小航: 关闭校内 VPN（浏览客户端）",
        "category": "AI",
        "keywords": [
          "zhixiaohang",
          "智小航",
          "vpn",
          "关闭"
        ]
      }
    ]
  }
}
